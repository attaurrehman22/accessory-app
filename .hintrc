{
  "extends": [
    "development"
  ],
  "hints": {
    "axe/forms": "off",
    "button-type": "off",
    "compat-api/css": [
      "off",
      {
        "ignore": [
          "-moz-backface-visibility"
        ]
      }
    ],
    "no-inline-styles": "off",
    "axe/name-role-value": [
      "default",
      {
        "button-name": "off"
      }
    ],
    "axe/text-alternatives": "off",
    "axe/aria": "off",
    "axe/structure": "off"
  },
  "browserslist": [
    "defaults",
    "not ie 11",
    "not and_chr <= 127",
    "not chrome <= 127",
    "not samsung <= 25"
  ]
}